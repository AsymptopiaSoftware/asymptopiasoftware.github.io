---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SlotMachineOriginal from '../../components/slotmachine/SlotMachineOriginal.vue';
import ProjectDemoActions from '../../components/ProjectDemoActions.astro';
import ProfessorAutoDemo from '../../components/ProfessorAutoDemo.astro';
import professor from '../../content/professor.json';
import brand from '../../content/brand.json';

const buildNumber = import.meta.env.PUBLIC_BUILD_NUMBER || 'local';
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA?.slice(0,7) || 'local';
const siteVersion = 'v' + brand.versionSeries + '.' + buildNumber + '-dev';
---
<BaseLayout title="Asymptopia Software · Development Preview" description="Development preview of Asymptopia Software project windows and Professor demo.">
  <header class="site-header">
    <a class="brand-home" href="/" aria-label="Asymptopia Software homepage">
      <img class="brand-logo" src={brand.logo} alt={brand.logoAlt} width="380" height="127"/>
    </a>
  </header>
  <main class="dev-homepage" id="main-content">
    <h1 class="sr-only">Asymptopia Software development homepage</h1>
    <section class="slotmachine-embed" aria-label="Animated WELCOME slot machine">
      <SlotMachineOriginal client:only="vue" /></div>
      <ProjectDemoActions title="Slot Machine" sourceUrl="https://github.com/ccosse/slotmachine"
        liveUrl="https://www.asymptopia.com/slotmachine/#/" pageUrl="/projects/slotmachine/" />
    </section>

    <section class="glimpse-viewport glimpse--harmony" aria-label="Glimpse into d3SRT and Cosmic Harmony">
      <div class="portal-window"><img src="/images/d3srt-unified-harmony-focus-20261023.png" loading="lazy" decoding="async"
        alt="Cosmic Harmony planets and the connected d3SRT musical workspace" /></div>
      <ProjectDemoActions title="d3SRT + Cosmic Harmony" sourceUrl="https://github.com/ccosse/d3SightReadingTrainer"
        liveUrl="https://ccosse.github.io/d3SightReadingTrainer/#/" pageUrl="/projects/d3srt/" />
    </section>

    <section class="glimpse-viewport glimpse--tms" aria-label="Glimpse into TuxMathScrabble">
      <div class="portal-window"><img src="/images/tuxmathscrabble.png" loading="lazy" decoding="async"
        alt="A portion of the colorful TuxMathScrabble math crossword board" /></div>
      <ProjectDemoActions title="TuxMathScrabble" sourceUrl="https://github.com/ccosse/TuxMathScrabble"
        liveUrl="https://www.asymptopia.com/tuxmathscrabble" pageUrl="/projects/tuxmathscrabble/" />
    </section>

    <section class="glimpse-viewport glimpse--d3plot" aria-label="Glimpse into d3Plot">
      <div class="portal-window"><img src="/images/d3plot-multiwindow-session.png" loading="lazy" decoding="async"
        alt="A portion of a multiwindow d3Plot plotting session" /></div>
      <ProjectDemoActions title="d3Plot" sourceUrl="https://github.com/ccosse/d3plot"
        liveUrl="https://ccosse.github.io/d3plot/#/" pageUrl="/projects/d3plot/" />
    </section>

    <section class="professor-embed" aria-label="Professor working through rotating fraction problems">
      <ProfessorAutoDemo problem={professor.problem} label={professor.demoLabel} />
      <ProjectDemoActions title={professor.title} sourceUrl={professor.sourceUrl}
        liveUrl="/professor/preview/" pageUrl={professor.pageUrl} />
    </section>
    <p class="dev-note">Development homepage · changes here do not replace the public homepage</p>
  </main>
  <footer class="site-footer"><div class="build-info"><span class="site-version" title={"Git commit " + commitSha}>{siteVersion}</span></div></footer>
</BaseLayout>

<style>
.dev-homepage{width:100%;min-width:0}
.dev-note{text-align:center;color:#aebdb3;font:12px system-ui,sans-serif;padding:8px}
.glimpse-viewport {
  position:relative;width:100%;aspect-ratio:1000 / 154;
  margin:24px 0;padding:12px;overflow:hidden;border-radius:20px;
  background:#303734;isolation:isolate;
}
/* The outer bezel is deliberately lighter than the surrounding #111312 page.
   A separate rounded aperture reveals only a small crop of the larger image. */
.portal-window {
  position:relative;width:100%;height:100%;border-radius:20px;
  overflow:hidden;background:#121816;
  box-shadow:inset 0 0 0 1px rgba(240,255,244,.12),0 1px 3px rgba(0,0,0,.22);
}
.portal-window>img {
  position:absolute;display:block;left:var(--portal-x,50%);top:var(--portal-y,50%);
  width:var(--portal-width,210%);height:auto;max-width:none;
  transform:translate(-50%,-50%);pointer-events:none;
}
/* Screenshots remain larger than the aperture: the image is behind a window,
   not fitted into a tile. Approximately a fifth of each full image is visible. */
.glimpse--harmony{--portal-width:205%;--portal-x:49%;--portal-y:45%}
.glimpse--tms{--portal-width:210%;--portal-x:50%;--portal-y:49%}
.glimpse--d3plot{--portal-width:205%;--portal-x:50%;--portal-y:49%}
.professor-embed{position:relative;width:100%;height:clamp(280px,44vw,420px);margin:24px 0;overflow:hidden;border-radius:20px;background:#1c2c27}
@media(max-width:600px){
  .glimpse-viewport{padding:8px}
  .portal-window>img{width:max(var(--portal-width),1050px)}
  .glimpse--harmony{--portal-width:1050px;--portal-x:43%}
  .glimpse--tms{--portal-width:1100px;--portal-x:50%}
  .glimpse--d3plot{--portal-width:1100px;--portal-x:52%}
}
</style>
<style is:global>
/* The global site theme declares a light :root background. Override the entire
   dev document, not only the content area, to avoid a white band below the fold. */
html:has(.dev-homepage),
html:has(.dev-homepage) body,
html:has(.dev-homepage) .shell {
  background: #111312;
  color: #e0e8e1;
  min-height: 100%;
}
html:has(.dev-homepage) .site-header { border-bottom-color: #343c38; }
html:has(.dev-homepage) .site-footer { border-top-color: #343c38; }
html:has(.dev-homepage) .site-version { color: #d7e0d7; background: #26312b; }
</style>
