---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedScreenshot from '../../components/FeaturedScreenshot.astro';
---
<BaseLayout title="d3Plot | Asymptopia Software" description="Browser-based interactive scientific visualization for multidimensional data, plots, and linked views.">
  <main class="story-page">
    <a class="back-link" href="/">← Asymptopia Software</a>
    <h1>d3Plot</h1>
    <p class="story-intro">d3Plot explores datasets through configurable plots, histograms, and linked analytical views. The project spans multiple graph types and scientific exploration workflows.</p>
    <section aria-label="Featured screenshot">
      <h2>Inside the project</h2>
      <FeaturedScreenshot src="/images/d3plot-multiwindow-session.png"
        alt="Full d3Plot multiwindow scientific visualization screenshot showing histograms and multiple plot views"
        caption="Original multiwindow plot screenshot used as the source behind the homepage viewport." />
    </section>
    <p>The homepage's shallow portal is a masked view into this full screenshot. Open the image above to inspect the entire scene.</p>
    <nav aria-label="d3Plot project links">
      <a href="https://github.com/ccosse/d3plot" target="_blank" rel="noopener noreferrer">Source code</a>
      <a href="https://ccosse.github.io/d3plot/#/" target="_blank" rel="noopener noreferrer">Launch application</a>
      <a href="/">Development homepage</a>
    </nav>
  </main>
</BaseLayout>
<style>
.story-page{width:min(1050px,100%);margin:32px auto 60px;color:#e0e8e1;font:15px/1.65 system-ui,sans-serif}
.story-page h1{font-size:clamp(24px,3vw,34px);line-height:1.2;margin:18px 0}
.story-page h2{font-size:18px;margin:26px 0 8px}
.story-intro{max-width:850px}
.back-link,.story-page nav a{color:#b9e8bb}
.story-page nav{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.story-page nav a{padding:9px 13px;border:1px solid #586c5f;border-radius:9px;text-decoration:none}
.story-page nav a:hover{border-color:#b9e8bb}
</style>