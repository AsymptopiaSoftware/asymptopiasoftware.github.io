---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="d3Plot | Asymptopia Software" description="d3Plot is an interactive D3-based data exploration application with multiple plots, histograms, linked views, and analytical cuts.">
  <main class="project-page">
    <a href="/" class="back-link">← Asymptopia Software</a>
    <h1>d3Plot</h1>
    <p>d3Plot is an interactive D3-based data exploration application with multiple plots, histograms, linked views, and analytical cuts.</p>
    <p>The homepage shows a static image preview. Use the live link to open the working application.</p>
    <nav aria-label="d3Plot links">
      <a href="https://github.com/ccosse/d3plot" target="_blank" rel="noopener noreferrer">Source</a>
      <a href="https://ccosse.github.io/d3plot/#/" target="_blank" rel="noopener noreferrer">Live application</a>
      <a href="/">Homepage preview</a>
    </nav>
  </main>
</BaseLayout>
<style>
.project-page{width:min(760px,100%);margin:48px auto;color:#303030;line-height:1.65}
.project-page h1{font-size:2rem;margin:20px 0}
.back-link,.project-page nav a{color:#165a39}
.project-page nav{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.project-page nav a{padding:8px 12px;border:1px solid #aaa;border-radius:8px;text-decoration:none}
</style>
