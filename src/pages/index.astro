---
import BaseLayout from '../layouts/BaseLayout.astro';
import VueCheck from '../components/VueCheck.vue';
import brand from '../content/brand.json';

// The workflow supplies a new run number for each deployment.
// When developing locally, display an obvious non-production version.
const buildNumber = import.meta.env.PUBLIC_BUILD_NUMBER || '0';
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA?.slice(0, 7) || 'local';
const siteVersion = `v${brand.versionSeries}.${buildNumber}`;
---
<BaseLayout title={`${brand.name} | ${brand.slogan}`}>
  <header class="site-header">
    <a class="brand-home" href="/" aria-label={`${brand.name} homepage`}>
      <img
        class="brand-logo"
        src={`${brand.logo}?v=${siteVersion}`}
        alt={brand.logoAlt}
        width="380"
        height="127"
      />
    </a>
    <div class="build-info" title={`Git commit ${commitSha}`}>
      <span class="dev-label">{brand.developmentStatus}</span>
      <span class="site-version">{siteVersion}</span>
    </div>
  </header>
  <main>
    <h1>{brand.name} <span class="brand-separator">|</span> {brand.slogan}</h1>
    <p class="established">{brand.established}</p>
    <p class="blank-label">{brand.placeholder}</p>
    <div class="empty-stage" aria-label="Reserved space for future content"></div>
  </main>
  <footer class="technical-check">
    <p class="tech-heading">{brand.frameworkLabel}</p>
    <VueCheck client:load />
  </footer>
</BaseLayout>
