---
import BaseLayout from '../layouts/BaseLayout.astro';
import SlotMachineOriginal from '../components/slotmachine/SlotMachineOriginal.vue';
import ProjectDemoActions from '../components/ProjectDemoActions.astro';
import ProfessorDemo from '../components/ProfessorDemo.astro';
import D3SRTGlimpse from '../components/D3SRTGlimpse.astro';
import professor from '../content/professor.json';
import brand from '../content/brand.json';

const buildNumber = import.meta.env.PUBLIC_BUILD_NUMBER || 'local';
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA?.slice(0, 7) || 'local';
const siteVersion = 'v' + brand.versionSeries + '.' + buildNumber;
---
<BaseLayout title={brand.seo.title} description={brand.seo.description}>
  <header class="site-header">
    <a class="brand-home" href="/" aria-label={brand.name + ' homepage'}>
      <img class="brand-logo" src={brand.logo + '?v=' + siteVersion}
        alt={brand.logoAlt} width="380" height="127" />
    </a>
  </header>
  <main id="main-content">
    <h1 class="sr-only">{brand.name}</h1>
    <section class="slotmachine-embed" aria-label="Animated Asymptopia WELCOME slot machine">
      <SlotMachineOriginal client:only="vue" />
      <ProjectDemoActions
        title="Slot Machine"
        sourceUrl="https://github.com/ccosse/slotmachine"
        liveUrl="https://www.asymptopia.com/slotmachine/#/"
        pageUrl="/projects/slotmachine/"
      />
    </section>
    <section class="professor-embed" aria-label={professor.demoLabel}>
      <ProfessorDemo problem={professor.problem} label={professor.demoLabel} />
      <ProjectDemoActions title={professor.title} sourceUrl={professor.sourceUrl}
        liveUrl={professor.liveUrl} pageUrl={professor.pageUrl} />
    </section>
    <section class="d3srt-embed" aria-label="Static preview of d3SightReadingTrainer and Cosmic Harmony">
      <D3SRTGlimpse />
      <ProjectDemoActions
        title="d3SightReadingTrainer + Cosmic Harmony"
        sourceUrl="https://github.com/ccosse/d3SightReadingTrainer"
        liveUrl="https://ccosse.github.io/d3SightReadingTrainer/#/"
        pageUrl="/projects/d3srt/"
      />
    </section>
  </main>
  <footer class="site-footer">
    <div class="build-info">
      <span class="site-version" title={'Git commit ' + commitSha}>{siteVersion}</span>
    </div>
  </footer>
</BaseLayout>

<style>
.professor-embed {position:relative;width:100%;height:clamp(280px,44vw,420px);margin:24px 0;overflow:hidden;border-radius:20px;background:#303030;}
.d3srt-embed {position:relative;width:100%;height:clamp(148px,18vw,185px);margin:24px 0;overflow:hidden;border-radius:20px;background:#18232e;}
</style>
