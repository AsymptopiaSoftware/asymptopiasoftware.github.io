---
import BaseLayout from '../layouts/BaseLayout.astro';
import SlotMachineOriginal from '../components/slotmachine/SlotMachineOriginal.vue';
import ProjectDemoActions from '../components/ProjectDemoActions.astro';
import brand from '../content/brand.json';

const buildNumber = import.meta.env.PUBLIC_BUILD_NUMBER || 'local';
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA?.slice(0, 7) || 'local';
const siteVersion = 'v' + brand.versionSeries + '.' + buildNumber;
---
<BaseLayout title={brand.seo.title} description={brand.seo.description}>
  <header class="site-header">
    <a class="brand-home" href="/" aria-label={brand.name + ' homepage'}>
      <img class="brand-logo" src={brand.logo + '?v=' + siteVersion}
        alt={brand.logoAlt} width="380" height="127" />
    </a>
  </header>
  <main id="main-content">
    <h1 class="sr-only">{brand.name}</h1>
    <section class="slotmachine-embed" aria-label="Animated Asymptopia WELCOME slot machine">
      <SlotMachineOriginal client:only="vue" />
    </section>
    <ProjectDemoActions
      title="Slot Machine"
      sourceUrl="https://github.com/ccosse/slotmachine"
      launchUrl="https://www.asymptopia.com/slotmachine/#/"
      description="An original 3D slot machine built with Vue and Quasar. This compact homepage edition has seven animated reels, custom neon fruit and treasure symbols, and a WELCOME finish. Launch opens the classic standalone five-reel game."
    />
  </main>
  <footer class="site-footer">
    <div class="build-info">
      <span class="site-version" title={'Git commit ' + commitSha}>{siteVersion}</span>
    </div>
  </footer>
</BaseLayout>
