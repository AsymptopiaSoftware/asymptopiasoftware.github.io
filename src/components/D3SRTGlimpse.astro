---
/** A still glimpse, deliberately not a miniaturized music application. */
const sourceImage = '/images/d3srt-cosmic-workstation-m25.png';
const liveUrl = 'https://ccosse.github.io/d3SightReadingTrainer/#/';
---
<div class="d3srt-glimpse">
  <img src={sourceImage} alt="Cosmic Harmony chord map alongside d3SightReadingTrainer staff notation, piano, controls and harmonic views" width="2048" height="559" loading="lazy" decoding="async" />
  <div class="d3srt-glimpse__caption">
    <span>d3SightReadingTrainer <span aria-hidden="true">+</span> Cosmic Harmony</span>
    <a class="d3srt-glimpse__launch" href={liveUrl} target="_blank" rel="noopener noreferrer" aria-label="Open d3SightReadingTrainer; the preview does not play audio">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
      Explore
    </a>
  </div>
</div>
<style>
.d3srt-glimpse {position:absolute;inset:0;overflow:hidden;background:#17212d;}
.d3srt-glimpse > img {display:block;width:100%;height:100%;object-fit:cover;object-position:center 56%;opacity:.96;}
.d3srt-glimpse::after {content:'';position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(9,15,21,.94));pointer-events:none;}
.d3srt-glimpse__caption {position:absolute;z-index:2;left:22px;right:115px;bottom:13px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;color:#eff7f5;font-size:clamp(13px,2vw,20px);font-weight:600;text-shadow:0 1px 3px #000;}
.d3srt-glimpse__launch {display:inline-flex;align-items:center;gap:5px;min-height:32px;border:1px solid #b2ca9d;border-radius:6px;background:rgba(22,39,35,.94);color:#edf8e9;padding:4px 12px;text-decoration:none;font-size:12px;font-weight:600;text-shadow:none;white-space:nowrap;}
.d3srt-glimpse__launch:hover,.d3srt-glimpse__launch:focus-visible {color:#f1ff00;border-color:#f1ff00;}
.d3srt-glimpse__launch svg {width:16px;height:16px;}
@media(max-width:650px){.d3srt-glimpse__caption{left:12px;right:100px;bottom:8px;gap:8px;font-size:13px}.d3srt-glimpse__launch{min-height:29px;padding:2px 8px;font-size:11px}}
</style>
