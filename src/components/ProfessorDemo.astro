---
interface Props { problem: string; label: string; }
const {problem,label}=Astro.props;
---
<professor-demo data-problem={problem} aria-label={label}></professor-demo>
<script>
  import {mountProfessorDemo} from '../../prototypes/professor-stick-figure/src/compact-demo.js';
  import {chooseProfessorProblem} from '../../prototypes/professor-stick-figure/src/homepage-problems.js';
  class ProfessorDemoElement extends HTMLElement {
    controller: ReturnType<typeof mountProfessorDemo> | undefined;
    private currentProblem = '';
    private disposed = false;
    private mountLesson(problem: string) {
      this.controller?.destroy();
      this.currentProblem = problem;
      this.controller = mountProfessorDemo(this,{
        problem,autoplay:true,loop:true,muted:true,
        onCycle: () => {
          if (!this.disposed && this.isConnected) {
            this.mountLesson(chooseProfessorProblem(this.currentProblem));
          }
        }
      });
    }
    connectedCallback(){
      this.disposed = false;
      if(!this.controller)this.mountLesson(this.dataset.problem || chooseProfessorProblem(''));
    }
    disconnectedCallback(){
      this.disposed = true;
      this.controller?.destroy();
      this.controller = undefined;
    }
  }
  if(!customElements.get('professor-demo'))customElements.define('professor-demo',ProfessorDemoElement);
</script>
<style>
  professor-demo {display:block;width:100%;height:100%;min-width:0;}
</style>
